{
  "expo": {
    "name": "kbms",
    "slug": "kbms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kbms-adaptive-icon.png",
    "scheme": "kbms",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "io.github.dcoon.kbms",
      "icon": {
        "light": "./assets/images/ios-light.png",
        "dark": "./assets/images/ios-dark.png",
        "tinted": "./assets/images/ios-tinted.png"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.io.github.dcoon.kbms"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5FBC85",
        "foregroundImage": "./assets/images/kbms-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.dcoon.kbms",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "splash": {
      "image": "./assets/images/splash-icon-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#5FBC85"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/2072ccb2-ece5-42c9-bcac-5fb39dc3f13b"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to connect to bluetooth devices"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B635F",
          "image": "./assets/images/splash-icon-light.png",
          "dark": {
            "backgroundColor": "#5B635F",
            "image": "./assets/images/splash-icon-dark.png"
          },
          "imageWidth": 200
        }
      ],
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsImageWithMaxCount": 5
            }
          },
          "android": {
            "enabled": true
          }
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "expo-sharing-extension",
                  "bundleIdentifier": "io.github.dcoon.kbms.expo-sharing-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.io.github.dcoon.kbms"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "2072ccb2-ece5-42c9-bcac-5fb39dc3f13b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
