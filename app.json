{
  "expo": {
    "name": "kbms",
    "slug": "kbms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kbms-adaptive-icon.png",
    "scheme": "kbms",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "l",
      "buildNumber": "1",
      "supportsTablet": true,
      "icon": {
        "light": "./assets/images/ios-light.png",
        "dark": "./assets/images/ios-dark.png",
        "tinted": "./assets/images/ios-tinted.png"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.io.github.dcoon.kbms"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryBluetooth",
            "NSPrivacyAccessedAPITypeReasons": [
              "B1F7.1",
              "B1F7.2"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryBluetooth",
            "NSPrivacyAccessedAPITypeReasons": [
              "B1F7.1",
              "B1F7.2"
            ]
          }
        ]
      },
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "KBMS uses Bluetooth to discover, connect to, and monitor real-time data from your KiloVault HLX+ batteries.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/kbms-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.dcoon.kbms",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "splash": {
      "image": "./assets/images/splash-icon-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#5FBC85"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/2072ccb2-ece5-42c9-bcac-5fb39dc3f13b"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "extraGradleProps": [
              {
                "org.gradle.jvmargs": "-Xmx4096m -XX:MaxMetaspaceSize=1g -XX:+UseParallelGC"
              },
              {
                "key": "org.gradle.java.installations.auto-download",
                "value": "true"
              },
              {
                "key": "org.gradle.java.installations.auto-detect",
                "value": "true"
              },
              {
                "name": "org.gradle.logging.level",
                "value": "info"
              }
            ]
          }
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to connect to bluetooth devices"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B635F",
          "image": "./assets/images/splash-icon-light.png",
          "dark": {
            "backgroundColor": "#5B635F",
            "image": "./assets/images/splash-icon-dark.png"
          },
          "imageWidth": 200
        }
      ],
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsImageWithMaxCount": 5
            }
          },
          "android": {
            "enabled": true
          }
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./assets/adi-registration.properties"
          ]
        }
      ],
      "expo-image",
      "expo-web-browser",
      "./plugins/withJavaToolchain",
      "./plugins/withGradleProperties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "expo-sharing-extension",
                  "bundleIdentifier": "io.github.dcoon.kbms.expo-sharing-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.io.github.dcoon.kbms"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "2072ccb2-ece5-42c9-bcac-5fb39dc3f13b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}